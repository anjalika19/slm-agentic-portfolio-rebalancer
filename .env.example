# Copy to .env and fill in what you need. Every key is optional: the offline demo
# (fixture data + deterministic mock agents) needs none of them.

# --- Models ---
STRICT_MODEL=0                  # 1 = fail if a model call fails; 0 = fall back to mocks (flagged)
GEMMA_MODEL=gemma3:latest       # any local Ollama tag (see `ollama list`)
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# --- Live data (only for --provider live) ---
FRED_API_KEY=                   # macro leg (Economist)
ALPHAVANTAGE_API_KEY=           # news sentiment (falls back to Finnhub, then yfinance)
FINNHUB_API_KEY=

# --- scripts/eth/eth.mjs only ---
ETH_PRIVATE_KEY=
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
